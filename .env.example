# RealHermes server settings. Copy to .env (npm run setup:env creates it with owner-only permissions).
# Every value here is read only by the Node relay or launcher, never by the browser. Never prefix a credential
# with VITE_: Vite would publish it in the browser bundle. Values already set in your shell take precedence.
# docs/configuration.md explains every setting in detail.

# --- Hermes chat gateway (Hermes Agent API server) ---------------------------------------------------------------
# Root URL of the gateway's OpenAI-compatible API server, without /v1. Empty: use API_SERVER_HOST/API_SERVER_PORT
# from the environment if present, otherwise http://127.0.0.1:8642.
HERMES_CHAT_BASE_URL=http://127.0.0.1:8642
# Bearer key; must equal the gateway's API_SERVER_KEY. Generate one with: openssl rand -hex 32
# If empty, API_SERVER_KEY from the environment is used instead. Without a key, chat returns 503.
HERMES_API_KEY=

# --- Hermes audio backend (dashboard server: speech-to-text and text-to-speech) -----------------------------------
# Used by `npm run dev` and `npm start`. `npm run dev:full` and `npm run prod` start their own loopback backend with
# a fresh random token and ignore these two values.
HERMES_AUDIO_BASE_URL=http://127.0.0.1:9119
# Must equal the backend's HERMES_DASHBOARD_SESSION_TOKEN. Without it, audio routes return 503.
HERMES_AUDIO_SESSION_TOKEN=


# --- Local images and PDFs ("show me ... from my computer") -------------------------------------------------------
# Approved folders, colon-separated absolute paths, at most 8. Empty disables local discovery. Never /, your home
# folder or a parent of it, or a hidden folder (startup fails). Example: /path/to/approved/pictures:/path/to/docs
REALHERMES_LOCAL_ARTIFACT_ROOTS=

# --- PDF rendering ----------------------------------------------------------------------------------------------
# Absolute folder containing Poppler's pdfinfo and pdftoppm. Empty: the first absolute PATH folder that has both
# (for example /opt/homebrew/bin or /usr/bin). No Poppler: PDF artifacts are unavailable; images still work.
REALHERMES_POPPLER_DIR=

# --- Development relay ------------------------------------------------------------------------------------------
# Loopback port of the Express relay in `npm run dev` / `npm start`. If you change it, also change the /api proxy
# target in vite.config.ts.
PORT=3001

# --- Production (`npm run prod`) --------------------------------------------------------------------------------
# Loopback port that serves the built app and /api together. Must differ from REALHERMES_AUDIO_PORT.
REALHERMES_PORT=5173
# Loopback port of the audio backend that the launcher starts and owns.
REALHERMES_AUDIO_PORT=9119
# Python interpreter of your Hermes Agent installation. Empty: python3 from PATH.
# Example: /path/to/hermes-agent/venv/bin/python
HERMES_PYTHON=
# 1 enables the launcher's reverse SSH tunnel to the headset; 0 disables it.
REALHERMES_TUNNEL=0
# SSH host alias (from ~/.ssh/config) or plain hostname/IPv4 address of the headset. user@host is not accepted:
# put User, HostName and IdentityFile in your SSH config. Key authentication and host-key trust must already work.
REALHERMES_SSH_ALIAS=frame
# Loopback port on the headset that forwards to REALHERMES_PORT. Open http://127.0.0.1:<this port> on the headset.
REALHERMES_FRAME_PORT=5173
